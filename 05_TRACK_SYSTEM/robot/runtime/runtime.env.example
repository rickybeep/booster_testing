# Copy to /etc/booster-track-v10/runtime.env only after verifying every path.
# The candidate services intentionally fail to start without that file.

# Exact interpreter containing (or paired with) the firmware-compatible K1 SDK.
K1_PYTHON=/absolute/path/to/k1-aware-python3

# Exact directory containing booster_robotics_sdk_python and its dependencies.
PYTHONPATH=/absolute/path/to/k1-sdk/site-packages
K1_SDK_EXPECTED_ROOT=/absolute/path/to/k1-sdk/site-packages
PYTHONNOUSERSITE=1

# Exact ROS 2 and BoosterRos2Interface setup scripts on this robot variant.
ROS_SETUP=/opt/ros/humble/setup.bash
BOOSTER_ROS_SETUP=/opt/booster/BoosterRos2Interface/install/setup.bash
