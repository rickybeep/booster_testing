[Unit]
Description=BOOSTER TRACK V10 K1 telemetry daemon
Requires=k1-motion-guard.service
After=k1-motion-guard.service network.target
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
User=booster
Group=booster
WorkingDirectory=/opt/booster-track-v10/current/robot_runtime
EnvironmentFile=/etc/booster-track-v10/runtime.env
Environment=K1_TRACK_RUNTIME_DIR=/run/booster-track-v10
UMask=0027
ExecStartPre=/usr/bin/test -x ${K1_PYTHON}
ExecStart=/usr/bin/env ${K1_PYTHON} /opt/booster-track-v10/current/robot_runtime/k1_telemetry_daemon.py
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true

[Install]
WantedBy=k1-panel-v10.target
